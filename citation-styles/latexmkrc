# latexmk settings for the citation-style samples in Appendix B.

# The njit-*.bbx and njit-*.cbx styles live in the template folder above.
ensure_path('TEXINPUTS', '..');

$pdf_mode = 1;

# Running latexmk with no file name builds every page, style-acm.pdf,
# style-acs.pdf, and so on; Appendix B of the sample inserts them.
@default_files = ('style-*.tex');
