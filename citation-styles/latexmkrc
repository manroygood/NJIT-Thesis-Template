# latexmk settings for the citation-style samples.

# The njit-*.bbx and njit-*.cbx styles live in the template folder above.
ensure_path('TEXINPUTS', '..');

$pdf_mode = 1;

# Running latexmk with no file name builds every page, then the collection.
@default_files = ('style-*.tex', 'citation-styles.tex');

# When citation-styles.tex needs style-xxx.pdf, build it from style-xxx.tex.
add_cus_dep('tex', 'pdf', 0, 'style_page');
sub style_page {
    return system("latexmk -pdf -interaction=nonstopmode \"$_[0].tex\"");
}
