% njit-asce.bbx: ASCE citation style for the NJIT thesis template.
% Select it with style=njit-asce in packages.tex.
%
% ASCE journals cite by author and year, and the GSO asks for author-year
% citations in ASCE style. biblatex has no ASCE style, so this is a thin
% layer over the standard authoryear style, set up to look like the ASCE
% reference list:
%   Knuth, D. E., and Plass, M. F. (1981). "Breaking paragraphs into
%   lines." Software: Practice and Experience, 11(11), 1119-1184.
% Changes from authoryear:
%   - every author is listed family name first, with initials;
%   - "and" before the last author follows a comma;
%   - an author's name is repeated, not replaced by a dash;
%   - article and chapter titles are printed in quotation marks and in
%     sentence case ("Breaking paragraphs into lines"), as in ASCE
%     journals; type them in title case in references.bib, with braces
%     around words that keep their capitals, such as {NumPy};
%   - a journal entry reads Journal, 11(11), 1119-1184 (no "pp.").
% Journal names print exactly as written in references.bib. Write them out
% in full, as Chapter 5 of the sample asks (ASCE itself abbreviates them).
%
% Same license as njit_thesis.cls (LPPL 1.3c); see LICENSE.

\ProvidesFile{njit-asce.bbx}[2026/10/26 v1.1 NJIT thesis: ASCE bibliography style]

\RequireBibliographyStyle{authoryear}

\ExecuteBibliographyOptions{
  giveninits  = true,
  dashed      = false,
  maxbibnames = 99,
  maxcitenames = 2,
  uniquelist  = false,
  uniquename  = false
}

\DeclareNameAlias{sortname}{family-given}
\DeclareDelimFormat[bib]{finalnamedelim}{\addcomma\space\bibstring{and}\space}
\DeclareFieldFormat[article,inbook,incollection,inproceedings]{title}{\mkbibquote{#1\isdot}}
\DeclareFieldFormat[article,inbook,incollection,inproceedings]{titlecase}{%
  \ifboolexpr{test {\ifcurrentfield{title}} or test {\ifcurrentfield{subtitle}}}
    {\MakeSentenceCase*{#1}}{#1}}
\renewbibmacro*{volume+number+eid}{%
  \printfield{volume}%
  \printfield[parens]{number}%
  \setunit{\addcomma\space}%
  \printfield{eid}}
\DeclareFieldFormat[article]{pages}{#1}
\renewbibmacro*{journal+issuetitle}{%
  \usebibmacro{journal}%
  \setunit*{\addcomma\space}%
  \usebibmacro{volume+number+eid}%
  \setunit{\addspace}%
  \usebibmacro{issue+date}%
  \setunit{\addcolon\space}%
  \usebibmacro{issue}%
  \newunit}
\renewbibmacro{in:}{%
  \ifentrytype{article}{}{\printtext{\bibstring{in}\intitlepunct}}}

\endinput
