% njit-ama.bbx: AMA citation style for the NJIT thesis template.
% Select it with style=njit-ama in packages.tex.
%
% Follows the AMA Manual of Style, 11th edition, as summarized by the Purdue
% OWL guide listed in Appendix B of the sample. Built on the standard
% numeric style of biblatex.
%
%   Journal article  Knuth DE, Plass MF. Breaking paragraphs into lines.
%                    Software: Practice and Experience. 1981;11(11):1119-1184.
%   Book             Lamport L. LaTeX: A Document Preparation System. 2nd ed.
%                    Addison-Wesley; 1994.
%   Chapter          Cohen S. Title. In: Smith J, Jones M, eds. Book Title.
%                    2nd ed. Springer; 2007:101-130.
%   Dissertation     Adriazola J. Coherent Control of Dispersive Waves.
%                    Dissertation. New Jersey Institute of Technology; 2021.
%   Website          Author. Page title. Site name. Updated April 23, 2026.
%                    Accessed October 15, 2026. https://...
% (Journal and book titles are italic.)
%
% Up to six authors are listed; with seven or more, the first three are
% followed by "et al". Name prefixes stay in front: van der Walt SJ.
% Article and chapter titles are set in sentence case: type them in title
% case in references.bib and protect proper nouns and acronyms with braces,
% as in  title = {Stability of {KdV} Solitons}.
%
% AMA asks for journal names abbreviated as in PubMed. This template asks
% for journal names in full (Chapter 5 of the sample), so this style prints
% the journal field exactly as written in references.bib.
%
% Same license as njit_thesis.cls (LPPL 1.3c); see LICENSE.

\ProvidesFile{njit-ama.bbx}[2026/10/19 v1.0 NJIT thesis: AMA bibliography style]

\RequireBibliographyStyle{numeric}

\ExecuteBibliographyOptions{
  sorting     = none,
  maxbibnames = 6,
  minbibnames = 3,
  dateabbrev  = false,
  urldate     = long,
  pagetracker = false,
  useprefix   = true
}

%% Punctuation and strings

% Authors are separated by commas, with no "and".
\renewcommand*{\multinamedelim}{\addcomma\space}
\renewcommand*{\finalnamedelim}{\addcomma\space}
\renewcommand*{\andothersdelim}{\addcomma\space}
% Initials without periods or spaces: Knuth DE.
\renewcommand*{\bibinitperiod}{}
\renewcommand*{\bibinitdelim}{}
\renewcommand*{\bibinithyphendelim}{-}
% A period between elements, a colon after "In".
\renewcommand*{\newunitpunct}{\addperiod\space}
\renewcommand*{\intitlepunct}{\addcolon\space}

\NewBibliographyString{published,updated}
% For a document in English or American English (with or without babel).
\DefineBibliographyStrings{english}{
  andothers   = {et al},
  in          = {In},
  editor      = {ed\adddot},
  editors     = {eds\adddot},
  edition     = {ed\adddot},
  version     = {Version},
  phdthesis   = {Dissertation},
  mathesis    = {Master's thesis},
  urlseen     = {Accessed},
  published   = {Published},
  updated     = {Updated},
}
\DefineBibliographyStrings{american}{
  andothers   = {et al},
  in          = {In},
  editor      = {ed\adddot},
  editors     = {eds\adddot},
  edition     = {ed\adddot},
  version     = {Version},
  phdthesis   = {Dissertation},
  mathesis    = {Master's thesis},
  urlseen     = {Accessed},
  published   = {Published},
  updated     = {Updated},
}

% Hyphens in page ranges (1119-1184) and citation ranges (1-3), as in AMA.
% The language files set the dash, so it is changed through them.
\DefineBibliographyExtras{english}{\renewcommand*{\bibrangedash}{-}}
\DefineBibliographyExtras{american}{\renewcommand*{\bibrangedash}{-}}

%% Names: family name, then initials; never the full given name.

\DeclareNameFormat{njit@ama}{%
  \usebibmacro{name:family-given}
    {\namepartfamily}
    {\namepartgiveni}
    {\namepartprefix}
    {\namepartsuffix}%
  \usebibmacro{name:andothers}}
\DeclareNameAlias{default}{njit@ama}
\DeclareNameAlias{sortname}{njit@ama}
\DeclareNameAlias{author}{njit@ama}
\DeclareNameAlias{editor}{njit@ama}
\DeclareNameAlias{bookauthor}{njit@ama}
\DeclareNameAlias{translator}{njit@ama}
% "Smith JA" puts a space, not a comma, between family name and initials.
\renewcommand*{\revsdnamepunct}{}

%% Field formats

% Reference list labels: 1. 2. 3.
\DeclareFieldFormat{labelnumberwidth}{#1\adddot}

% Article, chapter, and web page titles: plain, sentence case.
\DeclareFieldFormat*{title}{\MakeSentenceCase*{#1}}
% Titles of books, dissertations, reports, and manuals: italic, as typed.
\DeclareFieldFormat[book,thesis,manual,report,collection,proceedings]
  {title}{\mkbibemph{#1}}
\DeclareFieldFormat[online,misc]{title}{#1}
\DeclareFieldFormat{booktitle}{\mkbibemph{#1}}
\DeclareFieldFormat{maintitle}{\mkbibemph{#1}}
\DeclareFieldFormat{journaltitle}{\mkbibemph{#1}}
\DeclareFieldFormat{subtitle}{#1}

\DeclareFieldFormat{edition}{%
  \ifinteger{#1}
    {\mkbibordedition{#1}~\bibstring{edition}}
    {#1\isdot}}
\DeclareFieldFormat{version}{\bibstring{version}~#1}
% No "p." before pages; the range dash is normalized to a hyphen.
\DeclareFieldFormat{pages}{\mkcomprange{#1}}
\setcounter{mincomprange}{100000}
\DeclareFieldFormat{volume}{#1}
\DeclareFieldFormat[article]{number}{\mkbibparens{#1}}
\DeclareFieldFormat{doi}{doi\addcolon\nolinkurl{#1}}
\DeclareFieldFormat{url}{\url{#1}}
\DeclareFieldFormat{urldate}{\bibstring{urlseen}\space#1}
\DeclareFieldFormat{type}{\ifbibstring{#1}{\bibstring{#1}}{#1}}

%% Building blocks

% Year;Volume(Issue):Pages
\newbibmacro*{njit@ama:journal}{%
  \printfield{journaltitle}%
  \newunit\newblock
  \printtext{%
    \printfield{year}%
    \setunit{\addsemicolon}%
    \printfield{volume}%
    \printfield{number}%
    \setunit{\addcolon}%
    \printfield{pages}}}

% Publisher; Year   or   Publisher; Year:Pages for a chapter.
\newbibmacro*{njit@ama:publisher+year}[1]{%
  \printlist{publisher}%
  \setunit*{\addsemicolon\space}%
  \printlist{institution}%
  \setunit*{\addsemicolon\space}%
  \printfield{year}%
  \ifstrequal{#1}{pages}
    {\setunit{\addcolon}%
     \printfield{pages}}
    {}}

% In: Editors, eds. Book Title. Edition.
\newbibmacro*{njit@ama:in}{%
  \bibstring{in}\printunit{\intitlepunct}%
  \ifnameundef{bookauthor}
    {\ifnameundef{editor}
       {}
       {\printnames{editor}%
        \setunit{\addcomma\space}%
        \ifnumgreater{\value{editor}}{1}
          {\bibstring{editors}}
          {\bibstring{editor}}}}
    {\printnames{bookauthor}}%
  \newunit\newblock
  \printfield{maintitle}%
  \newunit
  \printfield{booktitle}%
  \newunit\newblock
  \printfield{edition}}

% doi:..., then Accessed Month Day, Year. URL
% AMA puts no period after a DOI or URL; \nopunct drops the one that would
% end the reference.
\newbibmacro*{njit@ama:doi+url}{%
  \iftoggle{bbx:doi}
    {\printfield{doi}%
     \iffieldundef{doi}{}{\nopunct}}
    {}%
  \iftoggle{bbx:url}
    {\usebibmacro{njit@ama:url}}
    {}}
\newbibmacro*{njit@ama:url}{%
  \iffieldundef{url}
    {}
    {\newunit\newblock
     \printurldate
     \newunit\newblock
     \printfield{url}%
     \nopunct}}

\newbibmacro*{njit@ama:begin}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{author/editor+others/translator+others}%
  \setunit{\printdelim{nametitledelim}}\newblock
  \printfield{title}%
  \newunit
  \printfield{subtitle}%
  \newunit\newblock}

\newbibmacro*{njit@ama:end}{%
  \newunit\newblock
  \printfield{note}%
  \newunit\newblock
  \usebibmacro{addendum+pubstate}%
  \usebibmacro{finentry}}

% Editors as authors (an edited book): Smith J, Jones M, eds.
\renewbibmacro*{editor+others}{%
  \ifnameundef{editor}
    {}
    {\printnames{editor}%
     \setunit{\addcomma\space}%
     \ifnumgreater{\value{editor}}{1}
       {\bibstring{editors}}
       {\bibstring{editor}}%
     \clearname{editor}}}

%% Drivers

\DeclareBibliographyDriver{article}{%
  \usebibmacro{njit@ama:begin}%
  \usebibmacro{njit@ama:journal}%
  \newunit\newblock
  \usebibmacro{njit@ama:doi+url}%
  \usebibmacro{njit@ama:end}}

\DeclareBibliographyDriver{book}{%
  \usebibmacro{njit@ama:begin}%
  \printfield{edition}%
  \newunit\newblock
  \printfield{volume}%
  \newunit\newblock
  \usebibmacro{njit@ama:publisher+year}{}%
  \newunit\newblock
  \usebibmacro{njit@ama:doi+url}%
  \usebibmacro{njit@ama:end}}

\newbibmacro*{njit@ama:chapter}{%
  \usebibmacro{njit@ama:begin}%
  \usebibmacro{njit@ama:in}%
  \newunit\newblock
  \usebibmacro{njit@ama:publisher+year}{pages}%
  \newunit\newblock
  \usebibmacro{njit@ama:doi+url}%
  \usebibmacro{njit@ama:end}}
\DeclareBibliographyDriver{inbook}{\usebibmacro{njit@ama:chapter}}
\DeclareBibliographyDriver{incollection}{\usebibmacro{njit@ama:chapter}}
\DeclareBibliographyDriver{inproceedings}{\usebibmacro{njit@ama:chapter}}

\DeclareBibliographyDriver{thesis}{%
  \usebibmacro{njit@ama:begin}%
  \printfield{type}%
  \newunit\newblock
  \usebibmacro{njit@ama:publisher+year}{}%
  \newunit\newblock
  \usebibmacro{njit@ama:doi+url}%
  \usebibmacro{njit@ama:end}}

\DeclareBibliographyDriver{report}{%
  \usebibmacro{njit@ama:begin}%
  \printfield{type}%
  \setunit*{\addspace}%
  \printfield{number}%
  \newunit\newblock
  \usebibmacro{njit@ama:publisher+year}{}%
  \newunit\newblock
  \usebibmacro{njit@ama:doi+url}%
  \usebibmacro{njit@ama:end}}

% Software documentation: Title. Version 3.22a. Published September 24, 2026.
\DeclareBibliographyDriver{manual}{%
  \usebibmacro{njit@ama:begin}%
  \printfield{edition}%
  \newunit\newblock
  \printfield{version}%
  \newunit\newblock
  \printlist{organization}%
  \iflistundef{publisher}
    {\iffieldundef{month}
       {\setunit{\addsemicolon\space}%
        \printfield{year}}
       {\newunit\newblock
        \bibstring{published}\space\printdate}}
    {\setunit{\addperiod\space}%
     \usebibmacro{njit@ama:publisher+year}{}}%
  \newunit\newblock
  \usebibmacro{njit@ama:doi+url}%
  \usebibmacro{njit@ama:end}}

% Web page: Author. Title. Site name. Updated date. Accessed date. URL
% The date field holds the date the page was last updated. The URL always
% prints, even with url=false.
\DeclareBibliographyDriver{online}{%
  \usebibmacro{njit@ama:begin}%
  \printlist{organization}%
  \newunit\newblock
  \iffieldundef{year}
    {}
    {\bibstring{updated}\space\printdate}%
  \newunit\newblock
  \iftoggle{bbx:doi}
    {\printfield{doi}}
    {}%
  \usebibmacro{njit@ama:url}%
  \usebibmacro{njit@ama:end}}

% Talks and anything else: Title. Where it was presented. Month Year.
\DeclareBibliographyDriver{misc}{%
  \usebibmacro{njit@ama:begin}%
  \printfield{howpublished}%
  \newunit\newblock
  \printlist{organization}%
  \newunit\newblock
  \printdate
  \newunit\newblock
  \usebibmacro{njit@ama:doi+url}%
  \usebibmacro{njit@ama:end}}

\DeclareBibliographyAlias{collection}{book}
\DeclareBibliographyAlias{proceedings}{book}
\DeclareBibliographyAlias{mvbook}{book}
\DeclareBibliographyAlias{booklet}{book}
\DeclareBibliographyAlias{unpublished}{misc}
\DeclareBibliographyAlias{software}{manual}

\endinput
