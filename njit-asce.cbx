% njit-asce.cbx: citation part of the ASCE style; see njit-asce.bbx.
% Citations give the author and year in parentheses: (Knuth 1984),
% (Knuth and Plass 1981), (Harris et al. 2020), with \cite as well as
% \autocite and \parencite. Use \textcite for a name in the sentence:
% \textcite{Knuth1984} gives Knuth (1984).
%
% Same license as njit_thesis.cls (LPPL 1.3c); see LICENSE.

\ProvidesFile{njit-asce.cbx}[2026/10/23 v1.0 NJIT thesis: ASCE citation style]

\RequireCitationStyle{authoryear}

% \cite adds the parentheses too, as ASCE citations always have them.
\DeclareCiteCommand{\cite}[\mkbibparens]
  {\usebibmacro{prenote}}
  {\usebibmacro{citeindex}%
   \usebibmacro{cite}}
  {\multicitedelim}
  {\usebibmacro{postnote}}

\endinput
